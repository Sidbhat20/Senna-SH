NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Public address of the site, used in email links and WhatsApp shares
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Player emails (resend.com). Without a key, emails are queued and marked "not set up".
RESEND_API_KEY=
EMAIL_FROM=Sportshunt <tournaments@your-domain.in>
# Create from a poster (Claude reads the poster into the create wizard). Server only. Without it, organisers fill in
# the wizard by hand. Each read is one request to claude-opus-5-5, 45 s timeout, one retry.
ANTHROPIC_API_KEY=
# Show "Continue with Google" on /login. Turn on only after enabling the Google provider in Supabase.
NEXT_PUBLIC_GOOGLE_AUTH=
